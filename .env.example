# GitHub token
GITHUB_TOKEN=your_github_pat_here

# LLM provider: Change this to 'gemini' (or the keyword your code uses)
AUTOSECDEV_LLM_PROVIDER=gemini

# Gemini settings
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.0-flash

# Max patch attempts
AUTOSECDEV_MAX_PATCH_ITERATIONS=3

# Chroma settings
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=autosecdev_cwe_kb